# Configuração do Open WebUI (docker-compose.yml da raiz).
# Copie para .env e ajuste se precisar. Todos têm default no compose,
# então o .env é OPCIONAL.

# Segredo da sessão — defina um valor fixo p/ não deslogar a cada restart.
WEBUI_SECRET_KEY=troque-por-um-segredo-aleatorio

# URLs dos proxies (host.docker.internal = host onde os proxies publicam as portas).
# Só mude se rodar os proxies em outra máquina/porta.
QWEN_URL=http://host.docker.internal:3000/v1
DEEPSEEK_URL=http://host.docker.internal:3001/v1
GLM_URL=http://host.docker.internal:3002/v1
MINIMAX_URL=http://host.docker.internal:3003/v1

# Nenhum proxy exige auth (API_KEY vazio nos .env de cada proxy).
# O "none" é só placeholder p/ alinhar a lista; é ignorado pelos proxies.
QWEN_KEY=none
DEEPSEEK_KEY=none
GLM_KEY=none
MINIMAX_KEY=none
