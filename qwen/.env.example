PORT=3000
API_KEY=your_proxy_api_key

# Conta 1 (vira o id "acc1" -> qwen_profiles/acc1/)
QWEN_EMAIL=your_email@example.com
QWEN_PASSWORD=your_password

# Contas adicionais: numere o sufixo (acc2, acc3, ...). Manter >=2 contas dá ao
# anti-bot (captcha) pra onde rotacionar.
# QWEN_EMAIL2=second_email@example.com
# QWEN_PASSWORD2=your_password
